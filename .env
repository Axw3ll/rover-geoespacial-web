# ---------- Servidor ----------
PORT=3000
# Cadena larga y aleatoria: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=abcd1234efgh5678ijkl9012mnop3456qrst7890uvwx1234yzab5678cdef9012
# Cuenta administradora creada automáticamente si no existe
ADMIN_EMAIL=admin@rover.local
ADMIN_PASSWORD=CambiaEstaClave123

# ---------- MongoDB (Atlas recomendado por la práctica) ----------
MONGODB_URI=mongodb+srv://aarredondo_db_user:fdVkro1mpyicdyC6@cluster0.zewa607.mongodb.net/rover?retryWrites=true&w=majority&appName=Cluster0
# ---------- MQTT ----------
# Conexión del backend (TCP/TLS)
MQTT_URL=mqtt://test.mosquitto.org:1883

MQTT_USERNAME=
MQTT_PASSWORD=
# Conexión del navegador (MQTT sobre WebSockets seguros)
MQTT_WS_URL=wss://test.mosquitto.org:8081/mqtt
MQTT_WS_USERNAME=
MQTT_WS_PASSWORD=
# Prefijo de tópicos: <prefijo>/<DEVICE_ID>/tx | cmd | planner
# Con un broker público usa un prefijo poco adivinable y NUNCA lo uses con el robot real.
MQTT_TOPIC_PREFIX=udec/telematica/equipoX
DEVICE_ID=CAR01

# ---------- Planificador de rutas (control automático) ----------
PLANNER_ENABLED=true
# Tramo recto máximo por lote (m). El firmware además limita a 10 m y 30 s.
PLANNER_MAX_LEG_M=5
# Distancia al destino para darlo por alcanzado (m). El NEO-6M tiene ~2.5 m de error típico.
PLANNER_ARRIVE_RADIUS_M=3
# Desplazamiento mínimo entre dos posiciones para estimar el rumbo por GPS (m)
PLANNER_HEADING_MIN_M=1.5

# Zona horaria para interpretar el RTC DS3231 de la microSD
TZ=America/Mexico_City
